{
  "name": "endless-depths-16",
  "private": true,
  "description": "Standalone Endless Depths 16. Source of truth: src/. Built files sit in this folder for static hosting.",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --outfile=game.js --format=iife --minify --legal-comments=none --alias:grok/canvas=./src/grok-canvas.ts --jsx=automatic --target=es2020",
    "smoke": "node tests/smoke.mjs",
    "accept": "node tests/accept.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.0.0"
  }
}
